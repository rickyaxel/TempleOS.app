I64 a=7,b=3;
"%d %d %d %d %d\n",a+b,a-b,a*b,a/b,a%b;
"%d %d\n",-7/2,-7%2;
"%d\n",ToI64(2`10); // ` yields F64 (Compiler/OptPass012.HC IC_POWER)
"%d\n",1<<4+1;
"%d\n",BLACK<<12+WHITE<<8;
"%d\n",3+4&5;
U64 u=0x8000000000000000;
"%X %X\n",u>>1,u(I64)>>1;
I32 i5=-0x80000000;
"%X\n",i5>>1;
I16 i1; I32 j1;
j1=i1=0x12345678;
"%X %X\n",i1,j1;
"%d\n",ToI64(3.99);
"%d\n",ToI64(-3.99);
F64 f=1.5;
I64 k=f*3;
"%d\n",k;
//EXPECT:
//10 4 21 2 1
//-3 -1
//1024
//17
//3840
//7
//4000000000000000 C000000000000000
//FFFFFFFFC0000000
//5678 12345678
//3
//-3
//4
