//Redefining or forward-declaring a prelude class does not change the layout
//the runtime uses for its own structures (TempleOS's kernel keeps its compiled
//offsets): the program keeps running.
class CTask;
class CDC { I64 x; };
"%d\n",StrLen("abc");
Sleep(1);
"%d\n",ToI64(2.5)+1;
//EXPECT:
//3
//3
