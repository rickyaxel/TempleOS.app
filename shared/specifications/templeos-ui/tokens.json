  "roles": {
    "desktop.background": "DKGRAY",
    "topbar.background": "BLACK",
    "topbar.menu.background": "BLUE",
    "topbar.menu.text": "YELLOW",
    "topbar.tab.active.background": "WHITE",
    "topbar.tab.active.text": "BLUE",
    "topbar.tab.inactive.background": "DKGRAY",
    "topbar.tab.inactive.text": "WHITE",
    "topbar.overflow.background": "BROWN",
    "topbar.clock": "LTGREEN",
    "window.background": "WHITE",
    "window.border.active": "BLUE",
