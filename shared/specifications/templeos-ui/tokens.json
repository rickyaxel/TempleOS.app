  "button": {
    "source": "reference/original-templeos/Adam/Ctrls/CtrlsBttn.HC DrawCtrlBttn",
    "frame": "BLACK",
    "inset": 2,
    "label": "face XOR WHITE (palette index)",
    "faces": {
      "normal": "LTCYAN",
      "action": "LTGREEN",
      "selected": "YELLOW",
      "pressed": "BLUE",
      "character": "WHITE",
      "locked": "RED",
      "destructive": "RED"
    },
    "contrast": {
      "$comment": "WCAG ratio of face to label (face XOR WHITE). LTGRAY/DKGRAY (3.2) was rejected for normal keys.",
      "normal": 6.3,
      "action": 4.8,
      "selected": 12.5,
      "pressed": 12.5,
      "character": 21.0,
      "locked": 6.3,
      "destructive": 6.3
    }
  },
  "font": {
    "file": "shared/runtime/font8x8.bin",
    "source": "reference/original-templeos/Kernel/FontStd.HC (from FreeDOS, public domain per Doc/Credits.DD)",
    "cell": [
      8,
      8
    ],
    "scaling": "integer only (nearest neighbour); no fallback fonts"
  },
  "metrics": {
    "$comment": "Logical pixels. At the AUTO display scale one logical px is about 1 dp on Android and 1 pt on iPhone.",
    "standard": {
      "rowH": 20,
      "topBar": 20,
      "chrome": 16,
      "chromeBtn": 24,
      "keyRow": 24,
      "header": 20,
      "editorHeader": 16,
      "button": 22,
      "toolRow": 16,
      "kbdRow": 34
    },
    "large": {
      "rowH": 44,
      "topBar": 40,
      "chrome": 32,
      "chromeBtn": 44,
      "keyRow": 44,
      "header": 40,
      "editorHeader": 40,
      "button": 40,
      "toolRow": 36,
      "kbdRow": 44
    },
    "keyboard": {
      "landscapeRow": 26,
      "padding": 4,
      "repeatDelayMs": 400,
      "repeatMs": 60,
      "shiftDoubleTapMs": 400
    },
    "windowBorder": 8,
    "longPressMs": 550
  },
  "motion": {
    "$comment": "TempleOS has no transitions: state changes are immediate. The only periodic effect is the 530 ms caret blink.",
    "caretBlinkMs": 530,
    "transitions": "none"
  }
}