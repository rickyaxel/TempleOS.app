    "window.chrome.menu.text": "YELLOW",
    "window.chrome.close": "LTRED",
    "menu.background": "BLUE",
    "menu.border": "YELLOW",
    "menu.text": "YELLOW",
    "menu.text.disabled": "LTGRAY",
    "menu.title": "WHITE",
    "menu.check": "LTGREEN",
    "dialog.background": "WHITE",
    "dialog.border": "BLUE",
    "dialog.title": "BLUE",
    "dialog.text": "BLACK",
    "dialog.item.background": "LTCYAN",
    "dialog.input.background": "LTGRAY",
    "input.cursor": "BLUE",
    "editor.cursor": "RED",
    "editor.line.current": "WHITE",
