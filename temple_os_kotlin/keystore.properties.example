# Command-line release signing (docs/releasing.md). Copy to keystore.properties in this folder,
# which is gitignored, and fill it in on your own machine. Never commit keystore.properties or the
# keystore; keep both outside version control and in your encrypted backup.
# storeFile: absolute path to the upload keystore, outside the repository (~ is not expanded).
storeFile=/absolute/path/to/upload-keystore.jks
storePassword=
keyAlias=
keyPassword=
