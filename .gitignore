# Reference material is fetched/extracted by tools (see docs/upstream-research.md); not part of the product.
/reference/
.DS_Store
build/
.gradle/
local.properties
*.iml
.idea/
DerivedData/
xcuserdata/
*.xcuserstate
.build/
.swiftpm/
__pycache__/

# Android upload key (never commit signing material)
/temple_os_kotlin/keystore.properties
*.jks
*.keystore
keystore.properties
signing.properties
*.pepk
*.p12
# Signed release binaries (built locally, uploaded to Google Play, never committed)
*.aab
*.apk
*.apks
# Android Studio "Generate Signed Bundle/APK" output folders (bundle plus metadata and baseline profiles)
/temple_os_kotlin/app/release/
/temple_os_kotlin/app/bench/

# Apple signing and App Store Connect credentials (never commit)
*.p8
*.pem
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
# Archives and exports (built locally, uploaded to App Store Connect, never committed)
*.xcarchive/
*.ipa
*.dSYM/
*.dSYM.zip

# Local secrets and overrides
.env
.env.*
*.local.xcconfig
# Apple team is supplied locally; the tracked Signing.xcconfig only includes this ignored file.
*service-account*.json

# Device and validation evidence (test results, screenshots, crash reports, device logs) stays on
# the machine that produced it: it carries device identifiers and local paths. See AGENTS.md.
*.xcresult/
*.ips
/docs/**/evidence/
/docs/localization-evidence/
